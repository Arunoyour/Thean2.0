APP_ENV=development
APP_SECRET_KEY=replace-with-32-plus-char-random-secret-here
SUPER_ADMIN_TOKEN=replace-with-32-plus-char-random-admin-token

# ── Database URLs ─────────────────────────────────────────────────────────────
# For Docker (docker-compose): use service name 'db' as the host
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/thean
PHARMACY_DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/thean_pharmacy
DELIVERY_DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/thean_delivery
HAIRCUT_DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/thean_haircut

# For local development (outside Docker): replace 'db' with 'localhost'
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/thean
# PHARMACY_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/thean_pharmacy
# DELIVERY_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/thean_delivery
# HAIRCUT_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/thean_haircut

# ── Database schema names (defaults shown) ────────────────────────────────────
CORE_DATABASE_SCHEMA=T
PHARMACY_DATABASE_SCHEMA=PH
DELIVERY_DATABASE_SCHEMA=D
HAIRCUT_DATABASE_SCHEMA=HC

# ── Database pool settings ────────────────────────────────────────────────────
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40

# ── Auth & tokens ─────────────────────────────────────────────────────────────
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── OTP (set MOCK_OTP_ENABLED=false in production) ───────────────────────────
MOCK_OTP_ENABLED=true
MOCK_OTP_CODE=123456

# ── CORS (comma-separated list of allowed origins) ────────────────────────────
# Local development:
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:5175,http://127.0.0.1:5175
# Production (Oracle Cloud) — replace yourdomain.com with your actual domain:
# CORS_ORIGINS=https://thean.yourdomain.com,https://delivery.yourdomain.com,https://pharmacy.yourdomain.com,https://haircut.yourdomain.com,https://admin.yourdomain.com

# ── Media storage ─────────────────────────────────────────────────────────────
MEDIA_ROOT=storage
MEDIA_URL=/media

# ── Web Push / VAPID (optional — leave blank to disable push notifications) ───
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_MAILTO=mailto:admin@thean.app
