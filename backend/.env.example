APP_ENV=development
APP_SECRET_KEY=replace-this-with-a-long-random-secret-minimum-32-characters
SUPER_ADMIN_TOKEN=replace-this-with-a-long-random-admin-token-minimum-32-characters

# Core customer/shared database.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/thean
CORE_DATABASE_SCHEMA=T

# Pharmacy merchant/order database.
PHARMACY_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/thean_pharmacy
PHARMACY_DATABASE_SCHEMA=PH

# Delivery partner/order database.
DELIVERY_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/thean_delivery
DELIVERY_DATABASE_SCHEMA=D

# Haircut vendor/order database.
HAIRCUT_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/thean_haircut
HAIRCUT_DATABASE_SCHEMA=HC

DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Keep mock OTP disabled outside local development.
MOCK_OTP_ENABLED=true
MOCK_OTP_CODE=123456

# Production example:
# CORS_ORIGINS=https://app.example.com,https://pharmacy.example.com,https://admin.example.com
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:5175,http://127.0.0.1:5175,http://localhost:5176,http://127.0.0.1:5176

# Local media storage. In production, place this on persistent storage or object storage.
MEDIA_ROOT=storage
MEDIA_URL=/media

# Web push notifications. Generate production keys before enabling push.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_MAILTO=mailto:admin@thean.app
